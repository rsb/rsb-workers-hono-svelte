{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // Not public: reachable only through the BFF Worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  // Configuration (src/config.ts). Not secrets: an origin and a cookie's
  // name. Local dev serves the BFF over http, so `.dev.vars` names the
  // cookie `sid`; `pnpm check:config` reads the two together as the api
  // does. These alone are not a deployed config: BFF_ORIGIN is local dev's.
  "vars": {
    "BFF_ORIGIN": "http://localhost:5173",
    "SESSION_COOKIE": "__Host-sid"
  },
  // The secrets the api reads (src/config.ts), by name only: the values are
  // set with `wrangler secret put`, and local dev's are in .dev.vars, which
  // the dev seed writes. Declaring them here makes `wrangler types` read
  // this list, not .dev.vars, so the generated types are the same with or
  // without that file (P68). PEPPER_1 keys the password hashes (L48).
  "secrets": {
    "required": ["PEPPER_1"]
  },
  // Local only: wrangler keeps each database under .wrangler/, so there is
  // no database_id until the api is deployed. Each schema lives with its
  // data package (DB8). Two databases (L42): the app's todos, and who the
  // users are and which sessions they hold.
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "todo",
      "migrations_dir": "../../packages/data/d1/migrations/app"
    },
    {
      "binding": "IDENTITY_DB",
      "database_name": "todo-identity",
      "migrations_dir": "../../packages/data/d1/migrations/identity"
    }
  ]
}
