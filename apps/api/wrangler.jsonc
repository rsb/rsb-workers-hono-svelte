{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todo-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // Not public: reachable only through the BFF Worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  // Configuration (src/config.ts). Not secrets: an origin and a cookie's
  // name. Local dev serves the BFF over http, so `.dev.vars` names the
  // cookie `sid`.
  "vars": {
    "BFF_ORIGIN": "http://localhost:5173",
    "SESSION_COOKIE": "__Host-sid"
  },
  // Local only: wrangler keeps each database under .wrangler/, so there is
  // no database_id until the api is deployed. Each schema lives with its
  // data package (DB8). Two databases (L42): the app's todos, and who the
  // users are and which sessions they hold.
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "todo",
      "migrations_dir": "../../packages/data/d1/migrations/app"
    },
    {
      "binding": "IDENTITY_DB",
      "database_name": "todo-identity",
      "migrations_dir": "../../packages/data/d1/migrations/identity"
    }
  ]
}
